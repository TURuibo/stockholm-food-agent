{
  "permissions": {
    "allow": [
      "Bash(node:*)",
      "Read",
      "WebSearch",
      "WebFetch"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "node scripts/status.mjs" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          { "type": "command", "command": "node scripts/hook_postwrite.mjs" }
        ]
      }
    ]
  }
}
