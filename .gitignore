# Generated map view (rebuilt from data each run)
map/view.html

# Cached Michelin fetches (provenance kept in places.json source_url)
data/cache/

# Node
node_modules/
npm-debug.log*

# OS
Thumbs.db
.DS_Store

# transient recommendation shortlist
data/.last_shortlist.json

# Personal data — keep local, never publish (use the .example template instead)
data/taste_profile.md
data/suggestions.jsonl
# NOTE: data/visits.jsonl is intentionally tracked. Reviews submitted from the public
# map open a GitHub Issue; the log-visit Action appends them here and commits, so a
# `git pull` at home syncs them. (User chose "public is fine" for review data.)
# Same for data/feedback.jsonl: board reactions/notes open a "feedback" issue; the
# tune-feedback Action appends + commits, and /tune folds it into the taste profile.
